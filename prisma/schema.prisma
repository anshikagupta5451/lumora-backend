generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SkinProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  skinType      String
  concerns      String[]
  sensitivities String[]
  goals         String[]
  climateZone   String?
  monthlyBudget Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  brand       String
  category    String
  ingredients String[]
  price       Float
  imageUrl    String?
  barcode     String?  @unique  // NEW
  createdAt   DateTime @default(now())
  reviews     Review[]
  routineSteps RoutineStep[]
  recommendations Recommendation[]
  userProducts UserProduct[]
}

model Review {
  id                 String   @id @default(uuid())
  productId          String
  userId             String
  rating             Int
  title              String?
  comment            String
  skinType           String?
  concerns           String[]
  isAnonymous        Boolean  @default(false)
  isVerifiedPurchase Boolean  @default(false)
  createdAt          DateTime @default(now())
  product            Product  @relation(fields: [productId], references: [id])
  user               User     @relation(fields: [userId], references: [id])
}

model CheckIn {
  id        String   @id @default(uuid())
  userId    String
  mood      Int
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String
  passwordHash    String
  createdAt       DateTime         @default(now())
  pushToken       String?
  checkIns        CheckIn[]
  recommendations Recommendation[]
  reviews         Review[]
  routines        Routine[]
  userProducts UserProduct[]
  skinProfile     SkinProfile?
  posts Post[]
  postLikes PostLike[]
  comments Comment[]
}

model Ingredient {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  goodFor     String[]
  category    String
}

model Recommendation {
  id              String   @id @default(uuid())
  userId          String
  productId       String
  reason          String
  contextSnapshot Json
  helpful         Boolean?
  createdAt       DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id])
  user            User     @relation(fields: [userId], references: [id])
}

model Routine {
  id        String        @id @default(uuid())
  userId    String
  name      String
  timeOfDay String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])
  steps     RoutineStep[]
}

model RoutineStep {
  id             String  @id @default(uuid())
  routineId      String
  productId      String
  stepOrder      Int
  completedToday Boolean @default(false)
  product        Product @relation(fields: [productId], references: [id])
  routine        Routine @relation(fields: [routineId], references: [id])
}

model UserProduct {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id])
  customName     String?   // for products not in the catalog
  customBrand    String?
  openedAt       DateTime?
  expiresAt      DateTime?
  quantityTotal  Float?    // e.g. 50 (ml/g)
  quantityUnit   String?   // "ml" | "g" | "uses"
  quantityLeft   Float?    // current estimated remaining amount
  isFinished     Boolean   @default(false)
  createdAt      DateTime  @default(now())
}

model Post {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  tag       String?  // "General" | "Products" | "Question" etc.
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  postLikes PostLike[]
  comments Comment[]
}


model PostLike {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}


model Comment {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())
}