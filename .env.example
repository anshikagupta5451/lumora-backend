# Copy to .env and fill in. See the env table in README.md for what each one does
# and what happens when an optional one is missing.

# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
PORT=4000
# Server timezone: the 8 pm streak reminder and "checked in today" use it
TZ=Asia/Kolkata

# Google sign-in (must equal the app's EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID)
GOOGLE_WEB_CLIENT_ID=

# Optional: password-reset emails (code is logged to the console without these)
RESEND_API_KEY=
# Needs getlumora.site verified in Resend, e.g. Lumora <hello@getlumora.site>
EMAIL_FROM=
# Optional: where user replies go, e.g. hello@getlumora.site (Zoho inbox)
EMAIL_REPLY_TO=

# Optional: image uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=

# Optional: face scan + web suggestions (heuristic fallback without a key)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_SEARCH_MODEL=

# Optional
OPENWEATHER_API_KEY=
ADMIN_EMAILS=
